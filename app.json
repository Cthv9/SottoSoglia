{
  "expo": {
    "name": "SottoSoglia",
    "slug": "sottosoglia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sottosoglia",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sottosoglia.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.sottosoglia.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-system-ui",
        {
          "parentViewController": "optional"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
